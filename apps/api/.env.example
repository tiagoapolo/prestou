# Porta do servidor Fastify
NODE_ENV=development
PORT=3333

# URL pública do site, usada nos links enviados ao cliente.
PUBLIC_WEB_URL=http://localhost:3000

# PostgreSQL do Supabase via Transaction Pooler (porta 6543).
# Obrigatória em desenvolvimento, testes e produção.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_POOL_SIZE=5
DATABASE_SSL=true

# Origens permitidas no CORS (separadas por vírgula).
CORS_ORIGINS=http://localhost:3000

# --- Supabase Auth + Storage ---
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Publishable key (sb_publishable_...) ou anon key legada.
SUPABASE_ANON_KEY=sb_publishable_...
# Secret key (sb_secret_...) ou service_role legada. Somente no backend.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SUPABASE_RECEIPTS_BUCKET=receipts
SIGNED_URL_TTL_SECONDS=300

# Protege POST /api/internal/run-reminders chamado pelo cron Railway.
CRON_SECRET=

# --- Assistente de criação de cobrança ---
# Somente no backend. O modelo padrão é o nano de menor custo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_TIMEOUT_MS=15000

# --- Notificações ao prestador via WhatsApp ---
# WHATSAPP_MODE: "log" (default, grava a notificação no banco e no log, sem enviar)
#               | "cloud-api" (envia de verdade via Cloud API da Meta)
WHATSAPP_MODE=log

# Número público do WhatsApp do Prestou, usado nos links wa.me dos convites manuais.
WHATSAPP_PUBLIC_PHONE=5541963491134

# Só necessários quando WHATSAPP_MODE=cloud-api (ver ARCHITECTURE.md, seção WhatsApp):
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANG=pt_BR
# Opcional: destinatário autorizado pela Meta usado por `pnpm test:whatsapp`.
WHATSAPP_TEST_TO=
# Webhook inbound (ADR-009): verify token do handshake GET e app secret que
# assina os POSTs (X-Hub-Signature-256). Deixe vazio para manter o inbound
# fechado — mensagens só são processadas quando ambos estiverem configurados.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Verificação do número do prestador (start/confirm em /api/whatsapp/number).
# No modo cloud-api o OTP é entregue por um template de autenticação aprovado na
# Meta (obrigatório) — o código nunca vai em texto livre nem é persistido/logado.
WHATSAPP_AUTH_TEMPLATE=
# O código é guardado como HMAC-SHA-256; sem segredo dedicado, deriva do
# SUPABASE_SERVICE_ROLE_KEY. TTL, cooldown de reenvio e nº máximo de tentativas.
WHATSAPP_VERIFICATION_SECRET=
WHATSAPP_VERIFICATION_TTL_MINUTES=10
WHATSAPP_VERIFICATION_RESEND_SECONDS=60
WHATSAPP_VERIFICATION_MAX_ATTEMPTS=5
# Tetos diários de envio de código, aplicados atomicamente no PostgreSQL.
WHATSAPP_VERIFICATION_PROVIDER_DAILY=5
WHATSAPP_VERIFICATION_CANDIDATE_DAILY=5
WHATSAPP_VERIFICATION_GLOBAL_DAILY=1000

# Cadastro iniciado pelo WhatsApp. `disabled` bloqueia qualquer onboarding;
# `invite_only` preserva o piloto assistido; `public` permite autoatendimento.
# Em produção, altere somente depois de configurar webhook assinado e Turnstile.
WHATSAPP_SIGNUP_MODE=disabled
# Compatibilidade temporária para ambientes ainda sem WHATSAPP_SIGNUP_MODE:
# true equivale a invite_only; false equivale a disabled.
WHATSAPP_SIGNUP_ENABLED=false
WHATSAPP_SIGNUP_TEMPLATE=convite_prestador
WHATSAPP_ONBOARDING_SECRET=
WHATSAPP_ONBOARDING_SESSION_TTL_MINUTES=1440
WHATSAPP_ONBOARDING_LINK_TTL_MINUTES=15
WHATSAPP_SIGNUP_GLOBAL_DAILY_LIMIT=50
WHATSAPP_SIGNUP_ENTRY_DAILY_LIMIT=500
WHATSAPP_SIGNUP_PHONE_DAILY_LIMIT=3
WHATSAPP_SIGNUP_EMAIL_COOLDOWN_SECONDS=60
TURNSTILE_SECRET_KEY=

# Guardrail de custo/abuso do webhook. Os limites são aplicados de forma
# atômica no PostgreSQL antes de qualquer chamada à OpenAI.
WHATSAPP_RATE_LIMIT_PER_MINUTE=10
WHATSAPP_DAILY_MESSAGE_LIMIT=100
WHATSAPP_MAX_MESSAGE_LENGTH=1000
WHATSAPP_GLOBAL_DAILY_AI_LIMIT=5000
WHATSAPP_ABUSE_COOLDOWN_MINUTES=30
WHATSAPP_INVALID_STREAK_LIMIT=3

# --- Testes integrados (use um projeto Supabase separado e descartável) ---
# O runner ignora os testes da API quando estas variáveis não estão presentes.
TEST_DATABASE_URL=
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
